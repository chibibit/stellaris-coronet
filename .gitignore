# ---- Paradox launcher and game output ----
# Launcher-side descriptors are generated by scripts/install.sh into the game's mod folder, never here.
/*.mod
*.log
*.bak
*.tmp
tmp/
dist/
build/

# ---- Working files of hand-made art ----
# Images are rendered from the SVGs in brand/ (ADR 0004); a painter's working file never belongs in the repo.
*.xcf
*.psd
*.kra

# ---- IDE and editor state ----
.vscode/
.idea/
*.swp
*~

# ---- OS clutter ----
Thumbs.db
desktop.ini
.DS_Store

# ---- Local-only working files ----
# Scratch, handovers and the optional reference notes under local/knowledge/ that the skills consult when present.
local/

# ---- Claude Code ----
# CLAUDE.md is checked in; its personal sibling is not (at any depth).
CLAUDE.local.md
# Committed config lives in .claude/; a ".local" or "-local" name part marks a personal file or folder
# (settings.local.json, rules/x.local.md, skills/x.local/, agent-memory-local/). A plain word that merely
# contains "local", such as "localisation", is not personal.
.claude/**/*.local.*
.claude/**/*.local/
.claude/**/*-local.*
.claude/**/*-local/
# Scratch state Claude Code creates while working.
.claude/worktrees/
.claude/todos/
.worktrees/
